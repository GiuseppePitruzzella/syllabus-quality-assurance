# Copy to backend/.env for local development.
# Only operational parameters live here. Scientific parameters
# (LLM/embedding model, temperature, RAG top-k, similarity threshold)
# are versioned in app/config.py:ScientificConfig and not overridable.

# === GCP / Vertex AI ===
# REQUIRED for RAG ingestion and agent calls. No fallback to `gcloud config`.
# If empty, scripts and services that use Vertex AI will fail with a clear
# error at startup. The project is part of the experimental configuration
# and is recorded in EvaluationResult for reproducibility.
GCP_PROJECT_ID=
# Default region. europe-west1 is the reference for the thesis.
GCP_LOCATION=europe-west1

# === Gemini backend selection (D080) ===
# Default true = Vertex AI (reproducible thesis path). Set false to use the
# free Gemini Developer API (AI Studio) with GEMINI_API_KEY.
# GENAI_USE_VERTEX=true
# Required when GENAI_USE_VERTEX=false. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Free-tier RPM cap for gemini-2.5-flash (default 5).
# GEMINI_API_RPM_LIMIT=5

# === Vector store / corpus paths (absolute or relative to project root) ===
# Defaults point to <project_root>/data/...; override only for testing.
# CHROMA_PERSIST_DIR=
# NORMATIVE_CORPUS_DIR=
# TAGGING_RULES_FILE=

# === Rate limiting ===
# Max RPM towards Vertex AI to avoid 429 (default: 30).
# VERTEX_AI_RPM_LIMIT=30

# === Logging ===
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === Persistence ===
# Override the default SQLite path only if needed.
# DATABASE_URL=sqlite:///./data/syllabus_ai.db

# === Scraping (existing) ===
# SCRAPE_DELAY=1.5
# SCRAPE_TIMEOUT=15
# SCRAPE_USER_AGENT=SyllabusAI/1.0 (UniCT research thesis)
